        },
        {
          "ruleId": "email.mtasts.missing",
          "ruleIndex": 1,
          "level": "note",
          "message": {
            "text": "No MTA-STS policy on clean.test.\nFix: Publish a policy."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "seta.yaml"
                },
                "region": {
                  "startLine": 9
                }
              },
              "logicalLocations": [
                {
                  "name": "clean.test",
                  "fullyQualifiedName": "clean.test",
                  "kind": "resource"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "setaFingerprint/v1": "f621c715e73c168a141142aac779eb35"
          },
          "suppressions": [
            {
              "kind": "external",
              "status": "accepted",
              "justification": "Receives no mail | legacy (until 2027-01-01)"
            }
          ],
          "properties": {
            "severity": "low",
            "target": "clean.test"
          }
        }
      ]
    }
  ]
}
