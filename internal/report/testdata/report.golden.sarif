                }
              ]
            }
          ],
          "partialFingerprints": {
            "setaFingerprint/v1": "1405c3678b2144f48a083fc27c3989a7"
          },
          "baselineState": "unchanged",
          "properties": {
            "evidence": {
              "record": "v=DMARC1; p=none"
            },
            "severity": "medium",
            "target": "broken.test"
