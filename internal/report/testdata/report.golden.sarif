              "implicit_mx": "192.0.2.80",
              "mx_records": "none"
            },
            "severity": "high",
            "target": "broken.test"
          }
        },
        {
          "ruleId": "email.mx.fcrdns",
          "ruleIndex": 2,
          "level": "note",
          "message": {
            "text": "MX host lacks forward-confirmed reverse DNS (mx2.broken.test) on broken.test."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "seta.yaml"
                },
                "region": {
                  "startLine": 4
                }
              },
              "logicalLocations": [
                {
                  "name": "broken.test",
                  "fullyQualifiedName": "broken.test/mx2.broken.test",
                  "kind": "resource"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "setaFingerprint/v1": "a1a02ba751d475630a31f6d03b9ea875"
          },
          "baselineState": "new",
          "properties": {
            "severity": "low",
            "subject": "mx2.broken.test",
            "target": "broken.test"
          }
        },
        {
          "ruleId": "email.dmarc.policy_none",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "DMARC policy is none on broken.test.\nrecord: v=DMARC1; p=none"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "seta.yaml"
                },
                "region": {
