{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "seta",
          "version": "dev",
          "informationUri": "https://github.com/PeacexF/seta",
          "rules": [
            {
              "id": "email.dmarc.policy_none",
              "shortDescription": {
                "text": "DMARC policy is none"
              },
              "fullDescription": {
                "text": "Spoofed mail is delivered."
              },
              "help": {
                "text": "Move to p=quarantine."
              },
              "helpUri": "https://www.rfc-editor.org/rfc/rfc7489",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "security-severity": "5.5",
                "tags": [
                  "security",
                  "email"
                ]
              }
            },
            {
              "id": "email.mtasts.missing",
              "shortDescription": {
                "text": "No MTA-STS policy"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "precision": "high",
                "security-severity": "3.0",
                "tags": [
                  "security",
                  "email"
                ]
              }
            },
            {
              "id": "email.mx.fcrdns",
              "shortDescription": {
                "text": "MX host lacks forward-confirmed reverse DNS"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "precision": "high",
                "security-severity": "3.0",
                "tags": [
                  "security",
                  "email"
                ]
              }
            },
            {
              "id": "email.mx.missing",
              "shortDescription": {
                "text": "No MX records"
              },
              "fullDescription": {
                "text": "Senders fall back to A records."
              },
              "help": {
                "text": "Publish MX records."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "precision": "high",
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "email"
                ]
              }
            },
            {
              "id": "email.spf.permissive_all",
              "shortDescription": {
                "text": "SPF record allows any sender"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "precision": "high",
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "email"
                ]
              }
            },
            {
              "id": "email.starttls.unsupported",
              "shortDescription": {
                "text": "No STARTTLS"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "precision": "high",
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "email"
                ]
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": [
            {
              "level": "error",
              "message": {
                "text": "email.mx.missing on flaky.test could not complete: lookup MX flaky.test: server responded SERVFAIL"
              },
              "associatedRule": {
                "id": "email.mx.missing"
              }
            }
          ]
        }
      ],
      "results": [
        {
          "ruleId": "email.spf.permissive_all",
          "ruleIndex": 4,
          "level": "error",
          "message": {
            "text": "SPF record allows any sender on broken.test.\nrecord: v=spf1 +all\nFix: Replace +all with -all or ~all."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "seta.yaml"
                },
                "region": {
                  "startLine": 4
                }
              },
              "logicalLocations": [
                {
                  "name": "broken.test",
                  "fullyQualifiedName": "broken.test",
                  "kind": "resource"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "setaFingerprint/v1": "d76344a4eb407126a3da395994e65640"
          },
          "baselineState": "new",
          "properties": {
            "evidence": {
              "record": "v=spf1 +all"
            },
            "severity": "critical",
            "target": "broken.test"
          }
        },
        {
          "ruleId": "email.mx.missing",
          "ruleIndex": 3,
          "level": "error",
          "message": {
            "text": "No MX records on broken.test.\nimplicit_mx: 192.0.2.80\nmx_records: none\nFix: Publish MX records."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "seta.yaml"
                },
                "region": {
                  "startLine": 4
                }
              },
              "logicalLocations": [
                {
                  "name": "broken.test",
                  "fullyQualifiedName": "broken.test",
                  "kind": "resource"
                }
              ]
            }
          ],
          "partialFingerprints": {
